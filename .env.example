# Adzuna aggregator API (free tier) — register at https://developer.adzuna.com/
# Without these, the Adzuna source is skipped; Platsbanken still runs (no key needed).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: only needed for the opt-in `job-hunter enrich` LLM layer.
# Never used by the automated daily run.
ANTHROPIC_API_KEY=
